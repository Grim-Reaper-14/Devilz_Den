+
+void DrawDevilsAimbotControls()
+{
+    using namespace Integrations::GTA5_Enhanced;
+
+    ImGui::TextColored(Bronze, "DEVILS_AIMBOT");
+    const bool available = DevilsAimbotAvailable();
+    bool enabled = DevilsAimbotEnabled();
+    bool aimForHead = DevilsAimbotAimForHead();
+    bool targetDrivers = DevilsAimbotTargetDrivers();
+
+    ImGui::BeginDisabled(!available);
+    if (ImGui::Checkbox("Devils_Aimbot", &enabled))
+        SetDevilsAimbotEnabled(enabled);
+    ImGui::EndDisabled();
+
+    ImGui::SameLine();
+    ImGui::BeginDisabled(!available || !enabled);
+    if (ImGui::Checkbox("Aim For Head", &aimForHead))
+        SetDevilsAimbotAimForHead(aimForHead);
+    ImGui::SameLine();
+    if (ImGui::Checkbox("Target Drivers", &targetDrivers))
+        SetDevilsAimbotTargetDrivers(targetDrivers);
+    ImGui::EndDisabled();
+
+    const char* status = DevilsAimbotStatusText();
+    if (!available)
+        ImGui::TextColored(EmberRed, "%s", status);
+    else
+        ImGui::TextDisabled("Uses GTA's assisted-aim/lock-on path. No per-frame world scan. %s", status);
+}
 }
 
